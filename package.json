{
  "name": "personal-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "npm run build:worker && wrangler dev --test-scheduled",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "deploy:ci": "npm run db:migrate:remote && opennextjs-cloudflare deploy",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db": "wrangler d1 execute portfolio --local",
    "db:migrate": "wrangler d1 migrations apply portfolio --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio --remote",
    "db:seed": "wrangler d1 execute portfolio --local --file seeds/demo.sql",
    "sync": "node --env-file=.dev.vars scripts/admin.mjs sync",
    "recalculate": "node --env-file=.dev.vars scripts/admin.mjs recalculate"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "decimal.js": "^10.6.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.146.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
